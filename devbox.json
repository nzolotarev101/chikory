{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.0/.schema/devbox.schema.json",
  "packages": [
    "nodejs@22",
    "pnpm@latest",
    "python@3.11",
    "uv@latest",
    "ruff@latest",
    "temporal-cli@latest"
  ],
  "env": {
    "NODE_OPTIONS": "--disable-warning=ExperimentalWarning"
  },
  "shell": {
    "init_hook": [],
    "scripts": {
      // Canonical task entry points — all humans, agents, and CI use these.
      "bootstrap": "pnpm install && uv --directory packages/sdk-py sync",
      "build": "pnpm -r build",
      "temporal-dev": "temporal server start-dev",
      "lint": "pnpm -r lint && ruff check packages/sdk-py && ruff format --check packages/sdk-py",
      "typecheck": "pnpm -r typecheck && (cd packages/sdk-py && uv run pyright)",
      "test": "pnpm -r test && (cd packages/sdk-py && uv run pytest) && bash scripts/test-scripts.sh",
      // Every scripts/test-*.sh in one place. Before this, test-dogfood-ac-preflight.sh
      // and test-dogfood-landed-scope.sh existed but nothing ever ran them.
      "test-scripts": "bash scripts/test-scripts.sh",
      "smoke": "bash scripts/smoke.sh",
      "run-dogfood": "bash scripts/dogfood.sh --run",
      "chain-dogfood": "bash scripts/dogfood.sh --chain",
      "dogfood-verify": "bash scripts/dogfood-verify.sh",
      "dogfood-progression": "bash scripts/dogfood-progression.sh",
      // /dogfood-review, scripted. `devbox run` does NOT forward positional args
      // to a named script, so the arg-taking forms are
      // `devbox run -- bash scripts/<name>.sh <arg>` — still one approval.
      //   open  = harvest (idempotent) + evidence pack + progression gate
      //   arm   = run EVERY acceptance check, both directions, timed vs the 120s cap
      //   docs  = bounded-block surgery · ledger row · README row · report scaffold
      //   close = structure + citations + coverage + suite, then commit and push
      "dogfood-open": "bash scripts/dogfood-open.sh",
      "dogfood-arm": "bash scripts/dogfood-arm.sh",
      "dogfood-docs": "node scripts/dogfood-docs.mjs",
      "dogfood-close": "bash scripts/dogfood-close.sh",
      "bench": "bash scripts/bench.sh",
      // One-stop bench: brings up Temporal + the codex judge proxy, then runs the
      // runnable brownfield corpus with the directive arm (Gemini executes /
      // Codex judges). Custom filters/tasks: devbox run -- bash scripts/bench-run.sh <args>.
      "bench-run": "bash scripts/bench-run.sh",
      // The raw Claude Code baseline arm this one is compared against. Claude is
      // the system UNDER MEASUREMENT here, not Chikory's executor — see the
      // script header before "correcting" it to gemini (F-260).
      "bench-baseline": "bash scripts/bench-baseline.sh",
      "judge-proxy": "node scripts/cli-judge-proxy.mjs 8787 codex",
      "harvest": "bash scripts/harvest.sh \"\" main",
      "harvest-audit": "bash scripts/harvest-audit.sh",
      // Reclaim run workspaces (F-236). Dry run by default; journals and
      // artifacts are never touched: devbox run -- bash scripts/prune-runs.sh --apply
      "prune-runs": "bash scripts/prune-runs.sh"
    }
  }
}
